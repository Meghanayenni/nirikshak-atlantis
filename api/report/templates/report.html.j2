{#
  NIRIKSHAK compliance report.

  Layout follows docs/ui_reference.html, which is the design specification for
  the P13 React interface. It is followed for tokens, hierarchy and the evidence
  block. It is deliberately NOT followed in three places, because the reference
  draws data this build does not have (see ADR 0015):

    * framework identifiers    - shown per finding since P17 (ADR 0035),
                                 with the scope of the run in provenance
    * no exposure rank         - priority_rank is unset until P12
    * no populated remediation - the vetted library is empty (D27)

  Each is omitted rather than rendered blank or filled with an example. A column
  of empty cells reads as missing data about the device; the absence of the
  column, plus a disclosure saying why, reads as what it is.

  Autoescaping is on. Every evidence line below is verbatim text from an
  uploaded configuration, and must render as characters rather than as markup.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NIRIKSHAK compliance report &mdash; {{ report.audit_id[:12] }}</title>
<style>
{{ stylesheet }}
</style>
</head>
<body>
<div class="wrap">

{% set glyph = {'fail': '✗', 'pass': '✓', 'unknown': '?', 'not_applicable': '–'} %}

<div class="doc-h">
  <h1>NIRIKSHAK &mdash; compliance report</h1>
  <p class="sub">
    {% if report.identity.hostname %}<span class="num">{{ report.identity.hostname }}</span>
    &middot; {% endif %}{{ report.platform_label }}
    &middot; file <span class="num">{{ report.config_file_id[:16] }}</span>
    &middot; {{ report.total }} check{{ '' if report.total == 1 else 's' }} evaluated
    {% if report.evaluated_at %}&middot; audited <span class="num">{{ report.evaluated_at }}</span>{% endif %}
  </p>
</div>

<!-- SUMMARY -->
<div class="sec">
  <h2>Summary</h2>
  <div class="tally">
    {% for key, label in [('fail', 'Fail'), ('unknown', 'Unknown'), ('pass', 'Pass'), ('not_applicable', 'Not applicable')] %}
    <div class="t">
      <b>{{ report.verdict_counts.get(key, 0) }}</b>
      <span>{{ label }}</span>
    </div>
    {% endfor %}
  </div>
  <p class="note" style="margin-top:14px">{{ report.ordering_basis }}</p>
</div>

<!-- COMPLIANCE POSTURE (ADR 0068) -->
{#
  Scored only when the gate is ready: every unrecognised line decided, and this
  run newer than every decision. Otherwise the gate's reason stands where a
  score would be, and no number appears. The percentage is never printed
  without the undetermined count and the coverage line beside it. No severity
  here: posture sits on the verdict axis, and severity stays on the findings.
#}
<div class="sec" id="posture">
  <h2>Compliance posture</h2>
  {% set p = report.posture %}
  {% if not p %}
  <div class="card"><div class="pad">
    <p class="note">No compliance posture was computed for this report, so no score is given.</p>
  </div></div>
  {% elif p.gate.state.value != 'ready' %}
  <div class="card gate"><div class="pad">
    <p><b>No compliance score &mdash; {{ p.gate.message }}</b></p>
    {% if p.gate.review %}
    <p class="note"><span class="num">{{ p.gate.review.reviewed }}</span> of
      <span class="num">{{ p.gate.review.total }}</span> unrecognised lines reviewed.</p>
    {% endif %}
    {% if p.gate.next_step %}<p class="note">{{ p.gate.next_step }}</p>{% endif %}
  </div></div>
  {% elif not p.mappings_attached %}
  <div class="card gate"><div class="pad">
    <p><b>No compliance score &mdash; control mappings are withheld.</b></p>
    <p class="note">{{ p.withheld_reason }}</p>
  </div></div>
  {% else %}
  {% for fw in p.frameworks %}
  <div class="card posture">
    <div class="card-h">
      <h3>{{ fw.document }}</h3>
      <span class="sub">edition {{ fw.edition }}</span>
    </div>
    <div class="pad">
    {% if fw.status.value != 'assessed' %}
      <p class="note">Not applicable &mdash; {{ fw.reason }}</p>
    {% else %}
      {% set assessed = fw.satisfied + fw.no_violation_found + fw.violated + fw.undetermined %}
      <div class="pbar" role="img" aria-label="{{ fw.satisfied }} fully satisfied, {{ fw.no_violation_found }} no violation found, {{ fw.violated }} violated, {{ fw.undetermined }} undetermined">
        {% if fw.satisfied %}<span class="p-sat" style="flex-grow:{{ fw.satisfied }}"></span>{% endif %}
        {% if fw.no_violation_found %}<span class="p-nvf" style="flex-grow:{{ fw.no_violation_found }}"></span>{% endif %}
        {% if fw.violated %}<span class="p-vio" style="flex-grow:{{ fw.violated }}"></span>{% endif %}
        {% if fw.undetermined %}<span class="p-und" style="flex-grow:{{ fw.undetermined }}"></span>{% endif %}
      </div>
      <p class="headline">
        <b><span class="num">{{ fw.satisfied }}</span> of <span class="num">{{ assessed }}</span>
        assessed controls fully satisfied</b> &middot;
        <span class="num">{{ fw.no_violation_found }}</span> no violation found (partial check) &middot;
        <span class="num">{{ fw.violated }}</span> violated &middot;
        <span class="num">{{ fw.undetermined }}</span> undetermined
      </p>
      <p class="legend">
        <span><i class="k p-sat"></i>Fully satisfied &mdash; a check testing the whole control passed</span>
        <span><i class="k p-nvf"></i>No violation found &mdash; checks passed, but each tests only part of the control</span>
        <span><i class="k p-vio"></i>Violated &mdash; a mapped check failed</span>
        <span><i class="k p-und"></i>Undetermined &mdash; a mapped check could not be answered</span>
      </p>
      <p class="note">
        {% if fw.catalog_total is not none %}<span class="num">{{ assessed }}</span> of
        <span class="num">{{ fw.catalog_total }}</span> catalog controls assessed by NIRIKSHAK.
        {% endif %}{{ fw.catalog_basis }}
        Only a fully satisfied control counts toward the first figure, so it can understate
        compliance and cannot overstate it.
      </p>

      <p class="label" style="margin:14px 0 6px">Did not comply</p>
      {% set violated = fw.controls | selectattr('state.value', 'equalto', 'violated') | list %}
      {% if not violated %}
      <p class="note">No assessed control was violated.</p>
      {% endif %}
      {% for c in violated %}
      <div class="pctl">
        <p><span class="num"><b>{{ c.control_id }}</b></span>
          <span class="plain">&mdash; {{ fw.framework | upper }} edition {{ fw.edition }}</span></p>
        {% for r in c.rules if r.verdict and r.verdict.value == 'fail' %}
        {% set item = report.by_rule.get(r.rule_id) %}
        <p class="note">Check <span class="num">{{ r.rule_id }}</span> failed on
          {% for e in r.evidence %}<span class="num">{{ e.file_path }}:{{ e.line_start }}</span>
          <code>{{ e.raw_line }}</code>{% if not loop.last %}; {% endif %}{% else %}no cited line
          ({{ r.absence_reason or 'the verdict rests on an absence' }}){% endfor %}
          &mdash; see the finding below.</p>
        {% if item and item.remediation.snippet %}
        <pre class="cmd">{% for cmd in item.remediation.snippet.commands %}{{ cmd }}{{ '\n' if not loop.last }}{% endfor %}</pre>
        {% if item.remediation.snippet.rollback %}
        <p class="label" style="margin:8px 0 4px">Rollback</p>
        <pre class="cmd">{% for cmd in item.remediation.snippet.rollback %}{{ cmd }}{{ '\n' if not loop.last }}{% endfor %}</pre>
        {% endif %}
        {% else %}
        <p class="note"><b>{{ item.remediation.statement if item else 'No vetted remediation was resolved for this check.' }}</b></p>
        {% endif %}
        {% endfor %}
      </div>
      {% endfor %}

      {% set nvf = fw.controls | selectattr('state.value', 'equalto', 'no_violation_found') | list %}
      {% if nvf %}
      <p class="label" style="margin:14px 0 6px">No violation found</p>
      {% for c in nvf %}
      <p class="note"><span class="num">{{ c.control_id }}</span> &mdash; partial check:
        NIRIKSHAK tests only part of this control.
        {% for r in c.rules %}<br><span class="num">{{ r.rule_id }}</span> &mdash; {{ r.coverage_reason }}{% endfor %}</p>
      {% endfor %}
      {% endif %}

      {% set undetermined = fw.controls | selectattr('state.value', 'equalto', 'undetermined') | list %}
      {% if undetermined %}
      <p class="label" style="margin:14px 0 6px">Could not be determined</p>
      {% for c in undetermined %}
      <p class="note"><span class="num">{{ c.control_id }}</span> &mdash; {{ c.reason }}</p>
      {% endfor %}
      {% endif %}
    {% endif %}
    </div>
  </div>
  {% endfor %}
  {% for name, why in p.unsourced.items() %}
  <p class="note">{{ name | upper }} &mdash; {{ why }}.</p>
  {% endfor %}
  <p class="note">Control mappings are this project's judgement, not taken from a published
    crosswalk. This section is evidence about one configuration, not a certification.</p>
  {% endif %}
</div>

<!-- SUBJECT -->
<div class="sec">
  <h2>Subject</h2>
  <div class="card"><div class="pad">
    <dl class="kv">
      {#
        Device identity. Every field here was already extracted and stored and
        stopped at the report boundary until P18 - a report named only by a
        content hash cannot be matched to a router by the person holding it.

        A field nothing read renders as "not reported", and the SERIAL renders
        with the reason it cannot be read at all. Blank would say "we looked and
        failed"; a configuration export does not contain a serial, and the two
        call for different responses.
      #}
      <dt>Hostname</dt>
      <dd>
        {% if report.identity.hostname %}<span class="num">{{ report.identity.hostname }}</span>
        {% else %}<span style="color:var(--muted)">not reported</span>{% endif %}
      </dd>
      <dt>Model</dt>
      <dd>
        {% if report.identity.model %}<span class="num">{{ report.identity.model }}</span>
        {% else %}<span style="color:var(--muted)">not reported</span>{% endif %}
      </dd>
      <dt>OS version</dt>
      <dd>
        {% if report.identity.os_version %}<span class="num">{{ report.identity.os_version }}</span>
        {% else %}<span style="color:var(--muted)">not reported</span>{% endif %}
      </dd>
      <dt>Serial</dt>
      <dd>
        {% if report.identity.serial %}<span class="num">{{ report.identity.serial }}</span>
        {% else %}<span style="color:var(--muted)">not applicable</span>
        {% if report.identity.serial_note %}
        <div style="color:var(--muted);font-size:11.5px;margin-top:2px">
          {{ report.identity.serial_note }}
        </div>
        {% endif %}{% endif %}
      </dd>
      <dt>Configuration file</dt>
      <dd>
        <span class="num">{{ report.config_file_id }}</span>
        <div style="color:var(--muted);font-size:11.5px;margin-top:2px">
          SHA-256 of the uploaded file's content. This identifies the file, not the
          device it came from &mdash; editing the configuration produces a different
          identifier.
        </div>
      </dd>
      {% if report.config_file_path %}
      <dt>Stored as</dt><dd class="num">{{ report.config_file_path }}</dd>
      {% endif %}
      <dt>Platform</dt>
      <dd>
        {{ report.platform_label }}
        {% if not report.vendor or not report.os_family %}
        <div style="color:var(--muted);font-size:11.5px;margin-top:2px">
          The platform was not identified, so no vendor pack applied and no
          remediation could be looked up.
        </div>
        {% endif %}
      </dd>
      <dt>Audit run</dt><dd class="num">{{ report.audit_id }}</dd>
      <dt>Report</dt><dd class="num">{{ report.report_id }}</dd>
    </dl>
  </div></div>
</div>

<!-- FINDINGS -->
<div class="sec">
  <h2>Findings</h2>

  {% if not report.findings %}
  <div class="card"><div class="pad">
    <p class="note">This run recorded no findings.</p>
  </div></div>
  {% endif %}

  {% for item in report.findings %}
  {% set f = item.finding %}
  <div class="finding">
    <div class="head">
      <span class="v v-{{ f.status.value }}">
        <span class="g">{{ glyph[f.status.value] }}</span>{{ f.status.value | upper | replace('_', ' ') }}
      </span>
      <span class="title">{{ f.expected }}</span>
      <span class="rid">{{ f.rule_id }}</span>
      <span class="sev s-{{ f.base_severity.value }}"><i></i>{{ f.base_severity.value | upper }}</span>
    </div>

    {#
      Control identifiers only - never the control's text (docs/CONTENT_POLICY).
      Rendered as plain metadata rather than as a verdict-coloured chip: a
      mapping is a cross-reference, and giving it semantic colour would put a
      second colour scale on a screen whose verdict signal depends on there
      being one.
    #}
    {% if f.frameworks %}
    <div class="pad" style="padding-top:0;padding-bottom:0">
      <p class="label" style="margin-bottom:2px">Mapped controls</p>
      <p style="color:var(--muted);font-size:11.5px;margin:0">
        {% for ref in f.frameworks %}<span class="num">{{ ref.framework.value | upper }}
        {{ ref.control_id }}</span>{% if ref.version %} (edition {{ ref.version }}){% endif %}
        &mdash; {{ ref.mapping_provenance.value | replace('_', ' ') }}, {{ ref.coverage.value }} check{% if not loop.last %};
        {% endif %}{% endfor %}
      </p>
    </div>
    {% endif %}

    <div class="pad">

      <div class="block">
        <p class="label">Observed</p>
        <dl class="kv">
          <dt>Value</dt>
          <dd class="num">{{ f.observed.value if f.observed.value is not none else 'none' }}</dd>
          <dt>Field state</dt>
          <dd class="num">{{ f.observed.state.value }}</dd>
          <dt>Confidence</dt>
          <dd>
            <span class="num">{{ '%.2f' | format(f.observed.confidence) }}</span>
            &mdash; {{ f.observed.confidence_method.value | replace('_', ' ') }}
            {% if not f.observed.confidence_is_probability %}
            <div style="color:var(--muted);font-size:11.5px;margin-top:2px">
              Not a probability. This number ranks and gates; it does not estimate
              the likelihood that the value is correct.
            </div>
            {% endif %}
          </dd>
        </dl>
      </div>

      {% if f.unknown_reason %}
      <div class="block">
        <p class="label">Why this check abstained</p>
        <p class="note">
          <span class="num">{{ f.unknown_reason.value | replace('_', ' ') }}</span>
          &mdash; the system could not establish this field's value to the standard a
          verdict requires, so it reports UNKNOWN rather than guessing.
        </p>
      </div>
      {% endif %}

      {% if f.absence_reason %}
      <div class="block">
        <p class="label">Absence citation</p>
        <p class="note">{{ f.absence_reason }}</p>
      </div>
      {% endif %}

      <div class="block">
        <p class="label">Evidence</p>
        {% if f.evidence %}
        {% for e in f.evidence %}
        <div class="file">{{ e.file_path }}</div>
        <div class="ev">
          <div class="row">
            <div class="ln">{{ e.line_start }}{% if e.line_end != e.line_start %}&ndash;{{ e.line_end }}{% endif %}</div>
            <div class="code">{{ e.raw_line }}</div>
          </div>
        </div>
        {% endfor %}
        {% else %}
        <p class="note">
          No line is cited. This verdict does not rest on an observed configuration
          line &mdash; see the abstention reason or absence citation above.
        </p>
        {% endif %}
      </div>

      <div class="block">
        <p class="label">Remediation
          {% if item.remediation.snippet %}
          <span class="plain">&mdash; vetted snippet
            {{ item.remediation.snippet.vendor }} / {{ item.remediation.snippet.os_family }}
            {%- if item.remediation.snippet.os_version_range %} {{ item.remediation.snippet.os_version_range }}{% endif %}
          </span>
          {% endif %}
        </p>

        {% if item.remediation.snippet %}
        {% set s = item.remediation.snippet %}
        {% if s.preconditions %}
        <p class="note" style="margin-bottom:8px">
          Before applying: {{ s.preconditions | join('; ') }}
        </p>
        {% endif %}
        <pre class="cmd">{% for c in s.commands %}{{ c }}{{ '\n' if not loop.last }}{% endfor %}</pre>
        {% if s.rollback %}
        <p class="label" style="margin:14px 0 6px">Rollback</p>
        <pre class="cmd">{% for c in s.rollback %}{{ c }}{{ '\n' if not loop.last }}{% endfor %}</pre>
        {% endif %}
        {% if s.verification %}
        <p class="note" style="margin-top:12px">
          Verify with: {{ s.verification | join('; ') }}
        </p>
        {% endif %}
        <p class="note" style="margin-top:12px">
          <b>Impact:</b>
          {{ 'service-affecting' if s.impact.service_affecting else 'not service-affecting' }},
          {{ 'requires a reload' if s.impact.requires_reload else 'no reload required' }},
          lockout risk {{ s.impact.lockout_risk.value }}.
          {% if s.impact.notes %}{{ s.impact.notes }}{% endif %}
          <br>{{ item.remediation.statement }}
          NIRIKSHAK does not execute these commands; an operator applies them.
        </p>
        {% else %}
        <div class="none">
          <b>{{ item.remediation.statement }}</b>
          <div class="why">
            {% if item.remediation.outcome.value == 'no_snippet' %}
            Commands are read only from the vetted snippet library and are never
            generated, so no command is offered here rather than a suggested one.
            {% elif item.remediation.outcome.value == 'platform_unknown' %}
            A remediation is looked up by vendor, OS family and rule. This file's
            platform was not identified, so there was nothing to look up.
            {% elif item.remediation.outcome.value == 'not_actionable' %}
            Nothing is proposed because nothing was found to be failing.
            {% endif %}
          </div>
        </div>
        {% endif %}
      </div>

    </div>
  </div>
  {% endfor %}
</div>

<!-- DISCLOSURES -->
{% if report.disclosures %}
<div class="sec">
  <h2>What this report does not claim</h2>
  <div class="disclose">
    <ul>
      {% for line in report.disclosures %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %}

<!-- PROVENANCE -->
<div class="foot">
  <dl class="kv">
    <dt>Engine</dt><dd class="num">{{ report.provenance.engine_version }}</dd>
    <dt>Benchmark scope</dt>
    <dd>
      {% if report.framework_selection %}
      <span class="num">{{ report.framework_selection | join(', ') | upper }}</span>
      &mdash; only rules mapping to these were evaluated
      {% else %}
      no benchmark filter &mdash; every applicable NIRIKSHAK check was evaluated
      {% endif %}
      {% for name, why in report.frameworks_excluded.items() %}
      <br><span class="num">{{ name | upper }}</span> selected and not applied &mdash; {{ why }}
      {% endfor %}
    </dd>
    {% if report.not_assessed %}
    <dt>Not assessed under this scope</dt>
    <dd>
      {% for rule_id, reason in report.not_assessed %}
      <span class="num">{{ rule_id }}</span> &mdash; {{ reason }}{% if not loop.last %}<br>{% endif %}
      {% endfor %}
    </dd>
    {% endif %}
    <dt>Rulepack</dt>
    <dd class="num">
      {{ report.provenance.rulepack_id or 'unknown' }}
      {{ report.provenance.rulepack_version or '' }}
      {% if report.provenance.rulepack_checksum %}
      &middot; {{ report.provenance.rulepack_checksum[:19] }}&hellip;
      {% else %}
      &middot; content not recorded (evaluated before rulepack checksums)
      {% endif %}
    </dd>
    {% if report.provenance.pack_versions %}
    <dt>Vendor packs</dt>
    <dd class="num">
      {% for name, version in report.provenance.pack_versions.items() %}
      {{ name }} {{ version }}{{ ', ' if not loop.last }}
      {% endfor %}
    </dd>
    {% endif %}
    <dt>Snippet library</dt>
    <dd class="num">
      {{ report.provenance.snippet_library_version }}
      ({{ report.provenance.snippet_count }} snippet{{ '' if report.provenance.snippet_count == 1 else 's' }})
    </dd>
    <dt>Generated</dt>
    <dd class="num">{{ report.provenance.generated_at.isoformat() }}</dd>
  </dl>
  <p style="margin-top:12px">
    Remediation was resolved when this report was generated, against the snippet
    library version named above. The compliance verdicts were decided when the
    audit ran and are reproduced here unchanged.
  </p>
</div>

</div>
</body>
</html>
